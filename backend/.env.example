# Bu faylni .env nomi bilan nusxalang va qiymatlarni to'ldiring.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Productionda admin panel domeni, masalan: https://admin.example.uz
DJANGO_CSRF_TRUSTED_ORIGINS=

DB_ENGINE=sqlite
DB_NAME=rentcar
DB_USER=rentcar
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Spamdan himoya
BOOKING_RATE_LIMIT=10/hour
BOOKINGS_PER_PHONE_PER_DAY=3
# Django oldidagi proxy'lar soni (Next.js server = 1)
NUM_PROXIES=1

TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_ADMIN_ID=replace-with-your-telegram-user-id
